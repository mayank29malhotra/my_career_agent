# Example .env file

# Required: GROQ API Key for LLM
GROQ_API_KEY=gsk_...

# Optional: NTFY for push notifications
NTFY_TOPIC=agent-alerts-xxxxx

# Optional: HuggingFace for LinkedIn data storage (production)
# Create a private dataset and upload your linkedin.txt there
HF_LINKEDIN_REPO=your-username/career-agent-data
HF_LINKEDIN_FILE=linkedin.txt
HF_TOKEN=hf_...
